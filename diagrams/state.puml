@startuml
[*] --> Выключено

Выключено --> Загрузка : включение питания
Загрузка --> Инициализация : POST завершен
Инициализация --> Готово : все сервисы запущены

Готово --> Сканирование : команда "scan"
Сканирование --> Готово : сканирование завершено

Готово --> Атака : команда "attack"
Атака --> Готово : атака завершена

Готово --> Формирование_отчета : команда "report"
Формирование_отчета --> Готово : отчет сформирован

Готово --> Сон : таймаут 10 мин
Сон --> Готово : нажатие кнопки

Готово --> Обновление : команда "update"
Обновление --> Готово : обновление завершено

Готово --> Выключено : команда "shutdown" / кнопка питания
Загрузка --> Выключено : сбой питания

Сканирование --> Атака : ошибка/прерывание
Атака --> Сканирование : возврат к сканированию

state Готово {
  [*] --> Ожидание_команд
  Ожидание_команд --> Обработка : команда получена
  Обработка --> Ожидание_команд : команда выполнена
}

@enduml
